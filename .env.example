# fin3 configuration template — copy to `.env` and fill in.
# Used by ClientConfig (FIN3_-prefixed environment variables, `__` nests).

# MinIO / S3-compatible storage (ArcticDB backend).
FIN3_MINIO__ENDPOINT=localhost:9000
FIN3_MINIO__ACCESS_KEY=changeme
FIN3_MINIO__SECRET_KEY=changeme

# Optional: EODHD API key for options ingestion.
# FIN3_EODHD_API_KEY=
